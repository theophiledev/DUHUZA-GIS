NODE_ENV=development
PORT=4000

# Frontend dev server (CORS)
FRONTEND_URL="http://localhost:5173,http://192.168.1.152:5173"

# PostgreSQL + PostGIS
DATABASE_URL="postgresql://duhuza:duhuza@localhost:5433/property_platform"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Location privacy — jitter radius (meters) applied to public_lat/public_lng
LOCATION_JITTER_METERS=400

# WhatsApp handoff (no Business API needed for MVP)
WHATSAPP_LINK_BASE="https://wa.me"

# MTN MoMo (Collections / Request-to-Pay) — see Phase 3, FR42-FR46
# Get these from https://momodeveloper.mtn.com after registering
MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MOMO_SUBSCRIPTION_KEY=""
MOMO_API_USER=""
MOMO_API_KEY=""
MOMO_TARGET_ENVIRONMENT="sandbox"
MOMO_CALLBACK_HOST=""
